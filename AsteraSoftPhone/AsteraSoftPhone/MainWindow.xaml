<Window x:Class="AsteraSoftPhone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASTERA Softphone"
        Width="760"
        Height="500"
        MinWidth="660"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="#182437"
        FontFamily="Segoe UI"
        Foreground="#172033">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Foreground="#FFFFFF"
                       FontSize="25"
                       FontWeight="Bold"
                       Text="ASTERA"/>
            <TextBlock Margin="0,-3,0,0"
                       Foreground="#9FB1CA"
                       FontSize="13"
                       Text="SOFTPHONE  •  PJSIP"/>
        </StackPanel>

        <Border Grid.Row="2"
                Padding="30"
                Background="#FBF8F2"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="13"
                             Height="13"
                             Fill="{Binding StatusColor}"
                             VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="{Binding StatusText}"/>
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#728096"
                                   Text="{Binding StatusDetail}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,24,0,0"
                        Background="#E4DED4"/>

                <Grid Grid.Row="2" Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Foreground="#7B8798" Text="ACCOUNT"/>
                        <TextBlock Margin="0,6,0,22"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding Account}"/>
                        <TextBlock Foreground="#7B8798" Text="TRANSPORT"/>
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding Transport}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Foreground="#7B8798" Text="SIP SERVER"/>
                        <TextBlock Margin="0,6,0,22"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding Server}"/>
                        <TextBlock Foreground="#7B8798" Text="LAST SIP CODE"/>
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding StatusCode}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Background="#2CB67D"
                    Foreground="White"
                    Command="{Binding ConnectCommand}"
                    Content="REGISTER"/>
            <Button Grid.Column="2"
                    Background="#EFF2F6"
                    Foreground="#243149"
                    Command="{Binding DisconnectCommand}"
                    Content="DISCONNECT"/>
        </Grid>
    </Grid>
</Window>
